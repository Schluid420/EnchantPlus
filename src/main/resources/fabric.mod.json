{
	"schemaVersion": 1,
	"id": "enchantplus",
	"version": "${version}",
	"name": "EnchantPlus",
	"description": "Removes enchanting randomness. Learn enchantments from books found in structure chests, then choose exactly what to apply at the enchanting table.",
	"icon": "assets/enchantplus/icon.png",
	"authors": [
		"Schluid"
	],
	"contact": {
		"homepage": "https://www.curseforge.com/minecraft/mc-mods/enchantplus",
		"sources": "https://github.com/Schluid420/EnchantPlus",
		"issues": "https://github.com/Schluid420/EnchantPlus/issues"
	},
	"license": "All-Rights-Reserved",
	"environment": "*",
	"entrypoints": {
		"main": [
			"io.github.schluid.enchantplus.EnchantPlus"
		],
		"client": [
			"io.github.schluid.enchantplus.client.EnchantPlusClient"
		],
		"modmenu": [
			"io.github.schluid.enchantplus.client.ModMenuIntegration"
		],
		"jei_mod_plugin": [
			"io.github.schluid.enchantplus.client.compat.EnchantPlusJeiPlugin"
		]
	},
	"mixins": [
		"enchantplus.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"jei": "*"
	}
}
